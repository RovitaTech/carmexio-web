{
  "name": "carmexio-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:carmexio-web": "node dist/carmexio-web/server/server.mjs",
    "test:ci": "ng test --watch=false",
    "verify": "npm run lint && npm run test:ci && npm run build",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "start:en": "ng serve --configuration=en --port 4201",
    "i18n": "ng extract-i18n && python3 scripts/i18n-build.py"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.8",
    "@supabase/supabase-js": "^2.117.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@angular/localize": "^22.1.7",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "^22.5.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.0.8"
  }
}
